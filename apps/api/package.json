{
  "name": "@tript/rosariovidacultural-api",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:production": "wrangler deploy --env production",
    "type-check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply rosariovidacultural-db --local",
    "db:migrate:staging": "wrangler d1 migrations apply rosariovidacultural-db-staging --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply rosariovidacultural-db --env production --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.3.5",
    "@cloudflare/workers-types": "^4.20241101.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.8",
    "wrangler": "^4.0.0"
  }
}
